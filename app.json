{
  "expo": {
    "name": "ElectionAppMobile",
    "slug": "election-app-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "electionappmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "usesCleartextTraffic": true,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a3f2e",
          "dark": {
            "backgroundColor": "#0a3f2e"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/assets/fonts/PlusJakartaSans-Regular.ttf",
            "./assets/assets/fonts/PlusJakartaSans-Bold.ttf",
            "./assets/assets/fonts/PlusJakartaSans-Medium.ttf",
            "./assets/assets/fonts/PlusJakartaSans-SemiBold.ttf",
            "./assets/assets/fonts/PlusJakartaSans-ExtraBold.ttf",
            "./assets/assets/fonts/PlusJakartaSans-Light.ttf"
          ]
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "ElectionWatch uses your photo library to upload PVC images for KYC.",
          "cameraPermission": "ElectionWatch uses your camera to capture PVC and selfie images for KYC.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
